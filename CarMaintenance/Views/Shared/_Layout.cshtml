@using System.Globalization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using CarMaintenance.Data
@inject IStringLocalizer<CarMaintenance.SharedResource> Localizer
@inject ILoggerFactory LoggerFactory
@inject AppDbContext _context

@{
    var culture = CultureInfo.CurrentCulture;
    var logger = LoggerFactory.CreateLogger("LayoutDebug");

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    Func<string, bool> isController = (ctrl) =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase);

    Func<string, string, bool> isPage = (ctrl, act) =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, act, StringComparison.OrdinalIgnoreCase);

    // --- User info ---
    string userName = "Guest";
    string userRole = "";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var loginName = User.Identity.Name;

        var currentUser = _context.Tbl_Users
            .FirstOrDefault(u => u.Email == loginName || u.MobileNumber == loginName);

        if (currentUser != null)
        {
            userName = currentUser.FirstName; // show first name
            userRole = currentUser.Role;      // show role
        }
    }
}

<!DOCTYPE html>
<html dir="@(culture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" lang="@culture.Name">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Localizer["AppTitle"]</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Fonts & CSS -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="~/AdminTheme/plugins/fontawesome-free/css/all.min.css">

    <!-- DataTables -->
    <link rel="stylesheet" href="~/AdminTheme/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/AdminTheme/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/AdminTheme/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">

    <!-- Theme -->
    <link rel="stylesheet" href="~/AdminTheme/dist/css/adminlte.min.css">

    @if (CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft)
    {
        <style>
            .main-sidebar {
                direction: rtl;
            }

                .main-sidebar .nav-sidebar .nav-item .nav-link {
                    text-align: right;
                }

                    .main-sidebar .nav-sidebar .nav-item .nav-link .nav-icon {
                        margin-left: .5rem;
                        margin-right: 0;
                    }

                    .main-sidebar .nav-sidebar .nav-item .nav-link p {
                        margin-right: .5rem;
                    }

                .main-sidebar .nav-sidebar .nav-item .right {
                    left: 1rem;
                    right: auto;
                    transform: rotate(180deg);
                }
        </style>
    }
</head>
<body class="hold-transition sidebar-mini @(culture.TextInfo.IsRightToLeft ? "layout-fixed" : "")">
    <div class="wrapper">

        <!-- NAVBAR -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-action="Index" asp-controller="Home" class="nav-link">@Localizer["HomeLink"]</a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a class="nav-link" asp-action="Logout" asp-controller="Account">@Localizer["LogoutLink"]</a>
                </li>
            </ul>

            <!-- Language Selector -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <form asp-action="SetLanguage" asp-controller="Home" method="post" class="form-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <select name="culture" onchange="this.form.submit();" class="form-control form-control-sm">
                            <option value="en" selected="@(culture.Name.StartsWith("en"))">English</option>
                            <option value="ar" selected="@(culture.Name.StartsWith("ar"))">Arabic</option>
                        </select>
                    </form>
                </li>
            </ul>
        </nav>
        <!-- /NAVBAR -->
        <!-- SIDEBAR -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand -->
            <a href="~/" class="brand-link">
                <img src="~/AdminTheme/dist/img/AdminLTELogo.png" alt="Logo"
                     class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">@Localizer["AppName"]</span>
            </a>

            <div class="sidebar">
                <!-- User panel -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="~/AdminTheme/dist/img/user2-160x160.jpg"
                             class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@userName</a>
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <small class="text-muted d-block">@userRole</small>
                        }
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">

                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link @(isPage("Home","Index") ? "active" : "")"
                               asp-action="Index" asp-controller="Home">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>@Localizer["DashboardLink"]</p>
                            </a>
                        </li>

                        <!-- Quick Search -->
                        <li class="nav-item">
                            <a class="nav-link @(isController("Reports") ? "active" : "")"
                               asp-controller="Reports" asp-action="Search">
                                <i class="nav-icon fas fa-file-pdf"></i>
                                <p>@Localizer["QuickSearchLink"]</p>
                            </a>
                        </li>

                        <!-- Cars -->
                        <li class="nav-item has-treeview @(isController("Cars") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("Cars") ? "active" : "")">
                                <i class="nav-icon fas fa-car"></i>
                                <p>@Localizer["NumberPlateSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("Cars") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Cars","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="Cars">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewNumberPlateLink"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Cars","AddCar") ? "active" : "")"
                                       asp-action="AddCar" asp-controller="Cars">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["AddNewNumberLink"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Customers -->
                        <li class="nav-item has-treeview @(isController("Customers") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("Customers") ? "active" : "")">
                                <i class="nav-icon fas fa-users"></i>
                                <p>@Localizer["CustomersSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("Customers") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Customers","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="Customers">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewCustomersLink"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Customers","AddCustomer") ? "active" : "")"
                                       asp-action="AddCustomer" asp-controller="Customers">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["AddNewCustomerLink"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Services -->
                        <li class="nav-item has-treeview @(isController("Services") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("Services") ? "active" : "")">
                                <i class="nav-icon fas fa-wrench"></i>
                                <p>@Localizer["ServicesSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("Services") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Services","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="Services">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewServicesLink"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Services","AddService") ? "active" : "")"
                                       asp-action="AddService" asp-controller="Services">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["AddNewServiceLink"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Receipts -->
                        <li class="nav-item has-treeview @(isController("Receipts") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("Receipts") ? "active" : "")">
                                <i class="nav-icon fas fa-receipt"></i>
                                <p>@Localizer["ReceiptsSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("Receipts") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Receipts","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="Receipts">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewReceiptsLink"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Receipts","AddReceipt") ? "active" : "")"
                                       asp-action="AddReceipt" asp-controller="Receipts">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["AddNewReceiptLink"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Transfer -->
                        <li class="nav-item has-treeview @(isController("TransferCars") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("TransferCars") ? "active" : "")">
                                <i class="nav-icon fas fa-share"></i>
                                <p>@Localizer["TransferSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("TransferCars") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("TransferCars","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="TransferCars">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewHistoryLink"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("TransferCars","Transfer") ? "active" : "")"
                                       asp-action="Transfer" asp-controller="TransferCars">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["TransferNewCarLink"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Users -->
                        <li class="nav-item has-treeview @(isController("Users") ? "menu-open" : "")">
                            <a href="#" class="nav-link @(isController("Users") ? "active" : "")">
                                <i class="nav-icon fas fa-user-lock"></i>
                                <p>@Localizer["UsersSection"] <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview" style="@(isController("Users") ? "display:block;" : "display:none;")">
                                <li class="nav-item">
                                    <a class="nav-link @(isPage("Users","Index") ? "active" : "")"
                                       asp-action="Index" asp-controller="Users">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>@Localizer["ViewUsersLink"]</p>
                                    </a>
                                </li>
                                @if (userRole == "Admin")
                                {
                                    <li class="nav-item">
                                        <a class="nav-link @(isPage("Users","AddUser") ? "active" : "")"
                                           asp-action="AddUser" asp-controller="Users">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>@Localizer["AddNewUserLink"]</p>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>
        <!-- /SIDEBAR -->
        <!-- CONTENT -->
        <div class="content-wrapper">
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>@Localizer["VersionLabel"]</b> 1.0.0
            </div>
            <strong>
                @Localizer["CopyrightText"]
                @DateTime.Now.ToString("yyyy")
                <a href="#">@Localizer["CompanyLink"]</a>.
            </strong>
            @Localizer["AllRightsReserved"]
        </footer>
    </div>

    <!-- SCRIPTS -->
    <script src="~/AdminTheme/plugins/jquery/jquery.min.js"></script>
    <script src="~/AdminTheme/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/AdminTheme/dist/js/adminlte.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
