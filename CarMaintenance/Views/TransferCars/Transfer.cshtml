@model CarMaintenance.Models.TransferCars
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["TransferCarsTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">@Localizer["Home"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["TransferCars"]</li>
                </ol>
            </div>
        </div>
        <hr />
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container">
        <form method="post" asp-action="Transfer" asp-controller="TransferCars">
            <div class="row my-2">

                <!-- From Customer -->
                <div class="col-md-6 form-group">
                    <label class="form-label">
                        @Localizer["From"]
                        <span class="text-danger fw-bold" asp-validation-for="FromCustomerID"></span>
                    </label>
                    <input type="text" id="FromCustomerName" class="form-control" placeholder="@Localizer["TypeCustomerName,E-Id,Mobile"]" />
                    <input type="hidden" id="FromCustomerID" name="FromCustomerID" asp-for="FromCustomerID" />
                </div>

                <!-- Number Plate -->
                <div class="col-md-6 form-group">
                    <label class="form-label">@Localizer["NumberPlate"]</label>
                    <input type="text" class="form-control" id="NumberPlate" name="NumberPlate" readonly />
                </div>

                <!-- Hidden Car ID -->
                <input type="hidden" id="CarID" name="CarID" asp-for="CarID" />

                <!-- To Customer -->
                <div class="col-md-6 form-group">
                    <label class="form-label">
                        @Localizer["To"]
                        <span class="text-danger fw-bold" asp-validation-for="ToCustomerID"></span>
                    </label>
                    <input type="text" id="ToCustomerName" class="form-control" placeholder="@Localizer["TypeCustomerName,E-Id,Mobile"]" />
                    <input type="hidden" id="ToCustomerID" name="ToCustomerID" asp-for="ToCustomerID" />
                </div>

                <!-- Transfer Date -->
                <div class="col-md-6 form-group">
                    <label class="form-label">
                        @Localizer["TransferDate"]
                        <span class="text-danger fw-bold" asp-validation-for="TransferDate"></span>
                    </label>
                    <input class="form-control" asp-for="TransferDate" />
                </div>

                <!-- Buttons -->
                <div class="col-md-12 my-2">
                    <button type="submit" class="btn btn-primary mr-2">@Localizer["TransferCarButton"]</button>
                    <button type="reset" class="btn btn-secondary">@Localizer["ResetButton"]</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>

    <script>
        $(document).ready(function () {
            // From Customer autocomplete
            $("#FromCustomerName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/TransferCars/SearchCustomers',
                        type: 'GET',
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    label: item.name + " | " + item.emiratesId + " | " + item.mobile,
                                    value: item.name,
                                    id: item.customerID,
                                    carID: item.carID,
                                    numberPlate: item.numberPlate
                                };
                            }));
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    $("#FromCustomerID").val(ui.item.id);
                    $("#FromCustomerName").val(ui.item.value);
                    $("#NumberPlate").val(ui.item.numberPlate);
                    $("#CarID").val(ui.item.carID);
                    return false;
                }
            });

            // To Customer autocomplete
            $("#ToCustomerName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/TransferCars/SearchCustomers',
                        type: 'GET',
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    label: item.name + " | " + item.emiratesId + " | " + item.mobile,
                                    value: item.name,
                                    id: item.customerID
                                };
                            }));
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    $("#ToCustomerID").val(ui.item.id);
                    $("#ToCustomerName").val(ui.item.value);
                    return false;
                }
            });
        });
    </script>
}
