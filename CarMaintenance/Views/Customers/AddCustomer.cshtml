@model Customers
@inject IViewLocalizer ViewLocalizer
@using CarMaintenance
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["AddCustomerTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index">@Localizer["HomeLink"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["CustomersBreadcrumb"]</li>
                </ol>
            </div>
        </div>
        <hr />
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container">
        <form method="post" asp-action="AddCustomer" asp-controller="Customers" id="customerForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row my-2">

                <div class="col-md-6 form-group">
                    <label asp-for="Name">@Localizer["Name"]</label>
                    <input class="form-control" asp-for="Name" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="Email">@Localizer["Email"]</label>
                    <input class="form-control" asp-for="Email" type="email" id="Email" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label class="form-label" asp-for="MobileNumber">@Localizer["MobileNumber"]</label>
                    <input class="form-control" asp-for="MobileNumber"
                           placeholder="05XXX XXXXX"
                           maxlength="11"
                           oninput="formatMobile(this)" />
                            
                    <span class="text-danger" asp-validation-for="MobileNumber"></span>
                </div>


                <div class="col-md-6 form-group">
                    <label asp-for="EmiratesID">@Localizer["EmiratesID"]</label>
                    <input class="form-control" asp-for="EmiratesID" id="emiratesID" maxlength="18" oninput="formatEmiratesID(this)" />
                    <span class="text-danger" asp-validation-for="EmiratesID"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="CarID">@Localizer["NumberPlate"]</label>
                    <select class="form-control" asp-for="CarID" asp-items="ViewBag.Cars">
                        <option value="">@Localizer["SelectNumberPlate"]</option>
                    </select>
                    <span class="text-danger" asp-validation-for="CarID"></span>
                </div>

                <div class="col-md-12 my-2">
                    <button type="submit" class="btn btn-primary">@Localizer["AddCustomerButton"]</button>
                    <button type="reset" class="btn btn-secondary">@Localizer["Reset"]</button>
                </div>

            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function formatEmiratesID(input) {
            let value = input.value.replace(/\D/g, '');
            let formatted = '';
            if (value.length > 0) formatted = value.slice(0, 3);
            if (value.length > 3) formatted += '-' + value.slice(3, 7);
            if (value.length > 7) formatted += '-' + value.slice(7, 14);
            if (value.length > 14) formatted += '-' + value.slice(14, 15);
            input.value = formatted.slice(0, 18);
        },
            function formatMobile(input) {
            let value = input.value.replace(/\D/g, ''); // keep only digits

            // Always start with "05"
            if (!value.startsWith("05")) {
                value = "05" + value.replace(/^0+/, "");
            }

            // Insert space after 5 digits
            if (value.length > 5) {
                input.value = value.slice(0, 5) + " " + value.slice(5, 10);
            } else {
                input.value = value;
            }
        }


    </script>
}
