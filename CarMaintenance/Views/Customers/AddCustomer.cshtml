@model Customers
@inject IViewLocalizer ViewLocalizer
@using CarMaintenance
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["AddCustomerTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index">@Localizer["HomeLink"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["CustomersBreadcrumb"]</li>
                </ol>
            </div>
        </div>
        <hr />
    </div>
</section>

<!-- Main Content -->
<section class="content">
    <div class="container">
        <form method="post" asp-action="AddCustomer" asp-controller="Customers" id="customerForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row my-2">
                <!-- Name -->
                <div class="col-md-6 form-group">
                    <label asp-for="Name">@Localizer["Name"]</label>
                    <input class="form-control" asp-for="Name" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>

                <!-- Email -->
                <div class="col-md-6 form-group">
                    <label asp-for="Email">@Localizer["Email"]</label>
                    <input class="form-control" asp-for="Email" type="email" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <!-- Mobile Number -->
                <div class="col-md-6 form-group">
                    <label asp-for="MobileNumber">@Localizer["MobileNumber"]</label>
                    <input class="form-control"
                           asp-for="MobileNumber"
                           id="MobileNumber"
                           placeholder="05XXX XXXXX"
                           maxlength="10"
                           title="Mobile number must start with 05 and be 10 digits long" />
                    <small class="form-text text-muted">
                        Example: 0501234567
                    </small>
                    <span class="text-danger" asp-validation-for="MobileNumber"></span>
                </div>

                <!-- Emirates ID -->
                <div class="col-md-6 form-group">
                    <label asp-for="EmiratesID">@Localizer["EmiratesID"]</label>
                    <input class="form-control"
                           asp-for="EmiratesID"
                           maxlength="18"
                           oninput="formatEmiratesID(this)" />
                    <span class="text-danger" asp-validation-for="EmiratesID"></span>
                </div>

                <!-- Buttons -->
                <div class="col-md-12 my-2">
                    <button type="submit" class="btn btn-primary">@Localizer["AddCustomerButton"]</button>
                    <button type="reset" class="btn btn-secondary">@Localizer["Reset"]</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ✅ Emirates ID formatting (xxxx-xxxx-xxxxxxx-x)
        function formatEmiratesID(input) {
            let value = input.value.replace(/\D/g, '');
            let formatted = '';
            if (value.length > 0) formatted = value.slice(0, 3);
            if (value.length > 3) formatted += '-' + value.slice(3, 7);
            if (value.length > 7) formatted += '-' + value.slice(7, 14);
            if (value.length > 14) formatted += '-' + value.slice(14, 15);
            input.value = formatted.slice(0, 18);
        }

        // ✅ Mobile number logic
        document.addEventListener("DOMContentLoaded", function () {
            const mobileInput = document.getElementById("MobileNumber");

            // Auto-insert 05 when focus
            mobileInput.addEventListener("focus", function () {
                if (!mobileInput.value.startsWith("05")) {
                    mobileInput.value = "05";
                }
            });

            mobileInput.addEventListener("input", function () {
                let value = mobileInput.value.replace(/\D/g, "");

                // Always start with 05
                if (!value.startsWith("05")) {
                    value = "05" + value.replace(/^0+/, "");
                }

                // Limit to 10 digits
                value = value.slice(0, 10);

                // Update the visible value
                mobileInput.value = value;

                // Validate only when 10 digits are filled
                const regex = /^05\d{8}$/;
                if (regex.test(value)) {
                    mobileInput.setCustomValidity(""); // valid
                } else {
                    mobileInput.setCustomValidity(""); // no redline while typing
                }
            });

            // On blur, check validity finally
            mobileInput.addEventListener("blur", function () {
                const regex = /^05\d{8}$/;
                if (!regex.test(mobileInput.value)) {
                    mobileInput.setCustomValidity("Mobile number must start with 05 and be 10 digits long.");
                } else {
                    mobileInput.setCustomValidity("");
                }
            });

            // Before submit: remove spaces (if any)
            document.getElementById("customerForm").addEventListener("submit", function () {
                mobileInput.value = mobileInput.value.replace(/\s/g, "");
            });
        });
    </script>
}
