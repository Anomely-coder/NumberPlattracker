@model List<CarMaintenance.Models.Users>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["UsersTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-@(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "left" : "right")">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">@Localizer["HomeLink"]</a>
                    </li>
                    <li class="breadcrumb-item active">@Localizer["UsersBreadcrumb"]</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@Localizer["CurrentUsersTitle"]</h3>
                <div class="card-tools">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="AddUser" asp-controller="Users" class="btn btn-primary btn-sm">
                            <i class="fas fa-user-plus"></i> @Localizer["AddNewUserButton"]
                        </a>
                    }
                </div>
            </div>

            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>@Localizer["Name"]</th>
                            <th>@Localizer["EmailLabel"]</th>
                            <th>@Localizer["DateAddedColumn"]</th>
                            <th>@Localizer["LastLoginColumn"]</th>
                            <th>@Localizer["PasswordStatusColumn"]</th>
                            <th>@Localizer["ActionsColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                bool isExpired = user.PasswordLastChanged.HasValue &&
                                (DateTime.Now - user.PasswordLastChanged.Value).TotalDays > 61;
                                <tr>
                                    <td>@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        @(user.LastLogin.HasValue
                                                                        ? user.LastLogin.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                                                        : Localizer["NeverText"])
                            </td>
                            <td>
                                @Html.Raw(
                                                                isExpired
                                                                ? $"<span class='text-danger'>{Localizer["ExpiredText"]}</span>"
                                                                : $"<span class='text-success'>{Localizer["ValidText"]}</span>"
                                                                )
                            </td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="EditUser" asp-controller="Users" asp-route-Id="@user.UserID"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> @Localizer["EditButton"]
                                            </a>

                                            <a href="@Url.Action("DeleteUser", "Users", new { Id = user.UserID })"
                                               class="btn btn-sm btn-danger delete-confirm">
                                                <i class="fas fa-trash"></i> @Localizer["DeleteButton"]
                                            </a>

                                            <a href="@Url.Action("ResetPassword", "Users", new { Id = user.UserID })"
                                               class="btn btn-sm btn-info reset-confirm">
                                                <i class="fas fa-key"></i> @Localizer["ResetPasswordButton"]
                                            </a>
                                        }
                                        else if (User.Identity?.Name != null &&
                                        string.Equals(User.Identity.Name, user.Email, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <a href="@Url.Action("ResetPassword", "Users", new { Id = user.UserID })"
                                               class="btn btn-sm btn-info reset-confirm">
                                                <i class="fas fa-key"></i> @Localizer["ResetPasswordButton"]
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@Localizer["NoActionsAvailable"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">@Localizer["NoUsersFound"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<style>
    .table th, .table td {
        vertical-align: middle;
    }

    .card-title {
        font-weight: 600;
    }

    .text-success {
        font-weight: 500;
    }

    .text-danger {
        font-weight: 500;
    }

    .swal-title-custom {
        font-weight: 600;
        font-size: 20px;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ✅ SweetAlert for DELETE confirmation
        $(".delete-confirm").on("click", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");

            Swal.fire({
                title: '<span class="swal-title-custom">@Localizer["DeleteUser"]</span>',
                html: '<p>@Localizer["AreYouSureDeleteUser"]</p>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '@Localizer["Delete"]',
                cancelButtonText: '@Localizer["Cancel"]',
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });

        // ✅ SweetAlert for RESET PASSWORD confirmation
        $(".reset-confirm").on("click", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");

            Swal.fire({
                title: '<span class="swal-title-custom">@Localizer["ResetPassword"]</span>',
                html: '<p>@Localizer["AreYouSureResetPassword"]</p>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '@Localizer["YesReset"]',
                cancelButtonText: '@Localizer["Cancel"]',
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });
    </script>
}
