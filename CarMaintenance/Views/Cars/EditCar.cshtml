@model CarMaintenance.Models.Cars
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["UpdateCarTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">@Localizer["HomeLink"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["CarsBreadcrumb"]</li>
                </ol>
            </div>
        </div>
        <hr />
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container">
        <form method="post" asp-action="EditCar" asp-controller="Cars">
            <div class="row my-2">
                <input asp-for="CarID" type="hidden" />

                <!-- Number Plate -->
                <div class="col-md-6 form-group">
                    <label class="form-label">@Localizer["NumberPlate"]</label>
                    <input class="form-control" asp-for="NumberPlate" />
                    <span class="text-danger" asp-validation-for="NumberPlate"></span>
                </div>

                <!-- Car Status (Hidden) -->
                <input asp-for="CarStatus" type="hidden" value="1" />

                <!-- Buttons -->
                <div class="col-md-12 my-2">
                    <button type="submit" class="btn btn-primary">@Localizer["UpdateCarButton"]</button>
                    <button type="reset" class="btn btn-secondary">Reset</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
