@model CarMaintenance.Models.Cars
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@using System.Globalization

@{
    bool isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["AddNewNumberPlateTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">@Localizer["HomeLink"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["CarsBreadcrumb"]</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container">
        <form method="post" asp-action="AddCar" asp-controller="Cars">
            <div class="row my-2">
                <!-- Number Plate Input -->
                <div class="col-md-6 form-group">
                    <label class="form-label">@Localizer["NumberPlateLabel"]</label>
                    <input class="form-control" asp-for="NumberPlate" />
                    <span class="text-danger" asp-validation-for="NumberPlate"></span>
                </div>

                <!-- Car Status Hidden -->
                <input type="hidden" asp-for="CarStatus" value="0" />

                <!-- Buttons -->
                <div class="col-md-12 my-2 @(isRtl ? "text-start" : "text-end")">
                    <button type="submit" class="btn btn-primary">@Localizer["AddNumberPlateButton"]</button>
                    <button type="reset" class="btn btn-secondary">Reset</button>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
