@model IEnumerable<CarMaintenance.Models.ViewModels.SearchResultViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

@{
    var searchTerm = ViewData["SearchTerm"] as string;
    var generatedBy = ViewData["GeneratedBy"] as string;
}

<div class="container mt-5" id="reportArea">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            <h2 class="mb-4 text-primary">🔍 @Localizer["Search Results"]</h2>

            <!-- Search Form -->
            <form method="get" asp-action="Search" asp-controller="Reports" class="mb-4 no-print">
                <div class="input-group">
                    <input type="text" id="searchTerm" name="searchTerm"
                           class="form-control"
                           value="@searchTerm"
                           placeholder="@Localizer["Search by name, email, number plate..."]"
                           autocomplete="off" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> @Localizer["Search"]
                    </button>
                </div>
            </form>

            <!-- Report Content -->
            <div id="reportContent">
                <div class="alert alert-info p-2">
                    <strong>@Localizer["GeneratedBy"]:</strong> @generatedBy <br />
                    <strong>@Localizer["CustomerName"]:</strong> @searchTerm
                </div>

                <hr />

                @if (string.IsNullOrEmpty(searchTerm))
                {
                    <div></div>
                }
                else if (!Model.Any())
                {
                    <div class="alert alert-warning">⚠️ @Localizer["NoResultsFound"]</div>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <div class="card mb-4 shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">@r.Customer.Name</h5>
                            </div>
                            <div class="card-body">
                                <p><strong>@Localizer["Email"]:</strong> @r.Customer.Email</p>
                                <p><strong>@Localizer["NumberPlate"]:</strong> @r.Customer.Cars?.NumberPlate</p>

                                @* Receipts *@
                                @if (r.Customer.Receipts?.Any() ?? false)
                                {
                                    <h6 class="mt-3 text-success">@Localizer["Receipts"]</h6>
                                    <table class="table table-bordered table-striped">
                                        <thead class="table-success">
                                            <tr>
                                                <th>@Localizer["DateLabel"]</th>
                                                <th>@Localizer["Amount"]</th>
                                                <th>@Localizer["ServicesLabel"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rec in r.Customer.Receipts)
                                            {
                                                <tr>
                                                    <td>@rec.Date.ToShortDateString()</td>
                                                    <td>@rec.TotalAmount.ToString("F2")</td>
                                                    <td>
                                                        <ul class="mb-0">
                                                            @foreach (var d in rec.ReceiptsDetails)
                                                            {
                                                                <li>@d.Services?.ServiceName</li>
                                                            }
                                                        </ul>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }

                                @* Transfers *@
                                @if (r.Transfers?.Any() ?? false)
                                {
                                    <h6 class="mt-3 text-info">@Localizer["Transfers"]</h6>
                                    <table class="table table-bordered table-striped">
                                        <thead class="table-info">
                                            <tr>
                                                <th>@Localizer["From"]</th>
                                                <th>@Localizer["To"]</th>
                                                <th>@Localizer["Date"]</th>
                                                <th>@Localizer["NumberPlate"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var t in r.Transfers)
                                            {
                                                <tr>
                                                    <td>@t.FromCustomers?.Name</td>
                                                    <td>@t.ToCustomers?.Name</td>
                                                    <td>@t.TransferDate.ToShortDateString()</td>
                                                    <td>@t.Cars?.NumberPlate</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- PDF Export -->
            <div class="d-flex justify-content-end mt-4 no-print">
                <button id="exportPdfClient" class="btn btn-success">
                    📄 @Localizer["ExportPdfButton"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        $("#searchTerm").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetSearchSuggestions", "Reports")',
                    data: { term: request.term },
                    success: function (data) { response(data); }
                });
            },
            minLength: 2,
            autoFocus: true
        });

        $("#exportPdfClient").click(function () {
            const { jsPDF } = window.jspdf;
            html2canvas(document.querySelector("#reportContent")).then(canvas => {
                const imgData = canvas.toDataURL("image/png");
                const pdf = new jsPDF("p", "mm", "a4");
                const imgWidth = 190;
                const pageHeight = 295;
                const imgHeight = canvas.height * imgWidth / canvas.width;
                let heightLeft = imgHeight;
                let position = 10;

                pdf.addImage(imgData, "PNG", 10, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, "PNG", 10, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }
                pdf.save("CustomerReport_Client.pdf");
            });
        });
    </script>
}
