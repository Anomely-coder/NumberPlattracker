@model IEnumerable<Services>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer
@using CarMaintenance

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@Localizer["ViewServicesTitle"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">@Localizer["HomeLink"]</a></li>
                    <li class="breadcrumb-item active">@Localizer["ServicesBreadcrumb"]</li>
                </ol>
            </div>
        </div>
        <hr />
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <a class="btn btn-primary my-3" asp-action="AddService" asp-controller="Services">@Localizer["AddServiceButton"]</a>
            </h3>
        </div>

        <div class="card-body">
            <table id="example1" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["ServiceID"]</th>
                        <th>@Localizer["ServiceName"]</th>
                        <th>@Localizer["Description"]</th>
                        <th>@Localizer["Price"]</th>
                        <th>@Localizer["Edit"]</th>
                        <th>@Localizer["Delete"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th>@item.ServiceID</th>
                                <td>@item.ServiceName</td>
                                <td>@item.Description</td>
                                <td>
                                    @item.Price
                                    <img src="~/images/logo2.png" alt="Logo" style="height:20px; width:auto; margin-right:5px;" />
                                    
                                </td>
                                <td>
                                    <a class="text-primary fas fa-pen"
                                       asp-action="EditService"
                                       asp-controller="Services"
                                       asp-route-Id="@item.ServiceID"></a>
                                </td>
                                <td>
                                    <a class="text-danger fas fa-trash delete-confirm"
                                       asp-action="DeleteService"
                                       asp-controller="Services"
                                       asp-route-Id="@item.ServiceID"></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center" colspan="6">@Localizer["NoRecordFound"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables & Plugins -->
    <script src="~/AdminTheme/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/AdminTheme/plugins/jszip/jszip.min.js"></script>
    <script src="~/AdminTheme/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/AdminTheme/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/AdminTheme/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/AdminTheme/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    

    <script>
        $(function () {
            $("#example1").DataTable({
                "responsive": true,
                "lengthChange": false,
                "autoWidth": false,
                "pageLength": 50,
                "buttons": [
                    {
                        extend: 'copy',
                        text: '@Localizer["CopyButton"]',
                        exportOptions: { columns: [0, 1, 2, 3] }
                    },
                    {
                        extend: 'csv',
                        text: '@Localizer["CsvButton"]',
                        exportOptions: { columns: [0, 1, 2, 3] }
                    },
                    {
                        extend: 'excel',
                        text: '@Localizer["ExcelButton"]',
                        exportOptions: { columns: [0, 1, 2, 3] }
                    },
                    {
                        extend: 'pdf',
                        text: '@Localizer["PdfButton"]',
                        exportOptions: { columns: [0, 1, 2, 3] }
                    },
                    {
                        extend: 'print',
                        text: '@Localizer["PrintButton"]',
                        title: '',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        customize: function (win) {
                            $(win.document.body).prepend(
                                '<div style="display:flex; justify-content:space-between; margin-bottom:20px;">' +
                                '<h2 style="margin:0;">@Localizer["ServicesReport"]</h2>' +
                                '<img src="/images/logo1.png" style="height:60px;" />' +
                                '</div>'
                            );
                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', '12px')
                                .css('width', '100%');
                        }
                    },
                    {
                        extend: 'colvis',
                        text: '@Localizer["ColumnVisibilityButton"]'
                    }
                ]
            }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');

            // Localized Delete Confirmation
                                  $(".delete-confirm").on("click", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");

            Swal.fire({
                title: '<span class="swal-title-custom">@Localizer["Delete Services"]</span>',
                html: '<p>@Localizer["AreYouSure"]</p>',
                showCancelButton: true,
                confirmButtonText: '@Localizer["Delete"]',
                cancelButtonText: '@Localizer["Cancel"]',
                focusCancel: true,
                customClass: {
                    popup: 'custom-swal',
                    title: 'swal-title',
                    confirmButton: 'swal-confirm-btn',
                    cancelButton: 'swal-cancel-btn'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        });

            // ✅ SweetAlert2 popup for TempData messages
            @if (TempData["ErrorMessage"] != null)
            {
                    <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@TempData["ErrorMessage"]'
                        });
                    </text>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: '@TempData["SuccessMessage"]'
                        });
                    </text>
            }
        });
    </script>
}
