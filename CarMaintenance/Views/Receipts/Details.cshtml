@model CarMaintenance.Models.Receipts
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ReceiptDetailsTitle"];
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="container mt-5">
    <div class="card shadow-lg p-4" style="border-radius: 20px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-primary">
                    <i class="fas fa-file-invoice"></i> @Localizer["ReceiptDetailsTitle"]
                </h2>
                <p class="text-muted">#@Model.ReceiptID | @Model.Date.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>
            <img src="~/images/logo1.png" alt="logo" style="height:60px;">
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <h5><i class="fas fa-user"></i> @Localizer["CustomerLabel"]</h5>
                <p class="text-secondary">@Model.Customers?.Name</p>
            </div>
            <div class="col-md-6">
                <h5><i class="fas fa-car"></i> @Localizer["NumberPlate"]</h5>
                <p class="text-secondary">@Model.Cars?.NumberPlate</p>
            </div>
        </div>

        <hr />

        <h5 class="mt-4 mb-3"><i class="fas fa-wrench"></i> @Localizer["ServicesLabel"]</h5>
        <table class="table table-hover">
            <thead class="table-primary">
                <tr>
                    <th>@Localizer["ServiceName"]</th>
                    <th>@Localizer["Description"]</th>
                    <th>@Localizer["Price"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ReceiptsDetails != null && Model.ReceiptsDetails.Any())
                {
                    foreach (var s in Model.ReceiptsDetails)
                    {
                        <tr>
                            <td>@s.Services?.ServiceName</td>
                            <td>@s.Services?.Description</td>
                            <td>
                                <img src="~/images/logo2.png" alt="logo" style="height:18px; margin-right:5px; vertical-align:middle;" />
                                @s.Services?.Price.ToString("N2")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">@Localizer["NoServicesFound"]</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-4">
            <h4>
                <strong>@Localizer["TotalAmountLabel"]</strong> @Model.TotalAmount.ToString("N2")
            </h4>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> @Localizer["BackToListButton"]
            </a>
        </div>
    </div>
</div>
